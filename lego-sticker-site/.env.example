# Kopie als .env anlegen und ausfüllen. Ohne Brevo-Daten läuft die Seite im
# Dev-Modus: Bestätigungslinks werden dann nur im Terminal ausgegeben.

# --- Server ---------------------------------------------------------------
PORT=3001
# Öffentliche Adresse der Seite (für Links in E-Mails). Lokal: Vite-Dev-Server.
PUBLIC_URL=http://localhost:5173
# In Produktion setzen (deaktiviert u. a. den Dev-Bestätigungslink).
# NODE_ENV=production
# Hinter einem Reverse Proxy (nginx, Render, Fly …) auf 1 setzen, damit das Rate-Limit die echte IP sieht.
# TRUST_PROXY=1

# Langes Zufalls-Secret für signierte Bestätigungslinks und E-Mail-Hashes.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Zugangscode für die Auswertung unter /stats
STATS_TOKEN=

# --- Brevo ----------------------------------------------------------------
# API-Schlüssel: Brevo → Einstellungen → SMTP & API → API-Schlüssel
BREVO_API_KEY=
# ID der Kontaktliste für die Warteliste (npm run brevo:setup legt sie an und gibt die ID aus)
BREVO_LIST_ID=
# Verifizierter Absender in Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kopfsache
# Optional: Benachrichtigung über jede bestätigte Anmeldung an diese Adresse
NOTIFY_EMAIL=
